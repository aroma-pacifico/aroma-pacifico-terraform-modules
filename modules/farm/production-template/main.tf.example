# One child invocation; resource and topic logic stays inside the reusable module.
module "farm" {
  source = "git::https://github.com/aroma-pacifico/aroma-pacifico-terraform-modules.git//modules/farm?ref=REQUIRED_REVIEWED_RELEASE"

  providers = { aws.project = aws.principal }

  client      = var.client
  project     = var.project
  environment = var.environment

  name_prefix     = local.name_prefix
  additional_tags = local.common_tags

  farm_id   = var.farm_id
  nodes     = local.nodes
  ingestion = local.ingestion
}
